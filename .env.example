# Set this in your ignored .env.local file or your hosting provider's
# server-side environment settings. Never commit a personal spreadsheet ID.
GOOGLE_SHEET_ID=
DASHBOARD_TIMEZONE=America/Toronto

# Optional: edit-triggered sync. See docs/EDIT-NOTIFICATIONS.md.
# poll = works immediately; webhook = read after a signed edit notification.
DASHBOARD_SYNC_MODE=poll
GOOGLE_WEBHOOK_SECRET=
# In webhook mode: 900 = safety read every 15 minutes while open.
# 0 = strictly event-only after the initial read (can miss script/API writes).
DASHBOARD_FALLBACK_SECONDS=900

# Recommended API mode. Enable Google Sheets API in Google Cloud.
# API keys work only with sheets the public can read.
GOOGLE_SHEETS_API_KEY=

# Optional JSON array of complete A1 ranges. Empty = discover monthly tabs
# in API mode; use the inspected Oct 2026–Oct 2027 tabs in public CSV mode.
GOOGLE_SHEET_RANGES=

# Optional semantic overrides if you rename a category to a custom name.
# Example: {"MY LANGUAGE STUDY":"learning","PERSONAL CARE":"health"}
GOOGLE_CATEGORY_DOMAINS=

# For a private sheet, share it (Viewer) with this service account.
# Use a real newline or escaped \n in the private key; never prefix with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional API-mode OAuth alternative. Use a read-only Sheets refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
